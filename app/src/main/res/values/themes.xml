<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- A cohesive Material 3 pantry theme shared by every screen. -->
    <style name="Base.Theme.SmartPantryManager" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/pantry_primary</item>
        <item name="colorOnPrimary">@color/pantry_on_primary</item>
        <item name="colorPrimaryContainer">@color/pantry_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/pantry_on_primary_container</item>
        <item name="colorSecondary">@color/pantry_secondary</item>
        <item name="colorOnSecondary">@color/pantry_on_secondary</item>
        <item name="colorSecondaryContainer">@color/pantry_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/pantry_on_secondary_container</item>
        <item name="colorTertiary">@color/pantry_tertiary</item>
        <item name="colorOnTertiary">@color/pantry_on_tertiary</item>
        <item name="colorSurface">@color/pantry_surface</item>
        <item name="colorSurfaceVariant">@color/pantry_surface_variant</item>
        <item name="colorOnSurface">@color/pantry_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/pantry_on_surface_variant</item>
        <item name="colorOutline">@color/pantry_outline</item>
        <item name="colorOutlineVariant">@color/pantry_outline_variant</item>
        <item name="colorError">@color/pantry_error</item>
        <item name="colorOnError">@color/pantry_on_error</item>
        <item name="colorErrorContainer">@color/pantry_error_container</item>
        <item name="android:colorAccent">@color/pantry_primary</item>
        <item name="android:navigationBarColor">@color/pantry_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.SmartPantryManager" parent="Base.Theme.SmartPantryManager" />

    <style name="ThemeOverlay.SmartPantry.Toolbar" parent="">
        <item name="actionMenuTextColor">@color/pantry_on_primary</item>
        <item name="colorControlNormal">@color/pantry_on_primary</item>
    </style>

</resources>
